# Unity generated and local caches
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
**/[Bb]in/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/
[Tt]est[Rr]esults/
[Aa]rtifacts/

# Unity generated diagnostics
crashlytics-build.properties
sysinfo.txt
*.[Cc]rash
[Aa]ssets/[Aa]ddressableAssetsData/*/*.bin*
.[Cc]onsulo/

# Always preserve Unity asset identity metadata
!/[Aa]ssets/**/*.meta

# Native Android/CMake build cache and ephemeral Unity CLI import state.
# These are regenerated per machine and must never be committed.
.utmp/
/[Aa]ssets/[Ee]ditor/UnityCliTemp-*/
/[Aa]ssets/[Ee]ditor/UnityCliTemp-*.meta
/[Aa]ssets/[Aa]ddressableAssetsData/[Aa]ndroid.meta
/[Aa]ssets/[Aa]ddressableAssetsData/[Aa]ndroid/addressables_content_state.bin.meta

# IDE and generated project files
.vs/
.vscode/
.idea/
.gradle/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Standalone .NET harness projects under tools or scripts are source
!/tools/**/*.csproj
!/scripts/**/*.csproj

# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
coverage/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# iOS/Xcode exports and native build artifacts
*.app
*.ipa
*.dSYM.zip
*.dSYM
DerivedData/
Pods/

# Credentials and local per-environment configuration
secrets.json
*.secrets.json
*.private.json
*.private.*
.credentials/
.env
.env.*
!.env.example
!*.example
fastlane/.env*
*.p8
*.p12
*.mobileprovision
*.cer
GoogleService-Info.plist

