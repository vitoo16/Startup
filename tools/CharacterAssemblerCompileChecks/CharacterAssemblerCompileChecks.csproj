<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Only Unity [SerializeField] backing fields are injected by scene/prefab serialization,
         so a standalone non-Unity compiler cannot detect their assignments.
         All other C# warnings remain errors in this harness. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PresentationChecks/StartupLife.PresentationModel.csproj" />
    <Compile Include="../../Assets/StartupLife/Scripts/Presentation/CharacterVisualAssembler.cs" Link="CharacterVisualAssembler.cs" />
    <Compile Include="../../Assets/StartupLife/Scripts/Presentation/CharacterCreatorVisualPreviewBridge.cs" Link="CharacterCreatorVisualPreviewBridge.cs" />
    <Compile Include="../../Assets/StartupLife/Scripts/Presentation/CharacterCreationViewController.cs" Link="CharacterCreationViewController.cs" />
    <Compile Include="../../Assets/StartupLife/Scripts/Presentation/CharacterCreatorTouchSizer.cs" Link="CharacterCreatorTouchSizer.cs" />
    <Compile Include="../../Assets/StartupLife/Scripts/Presentation/CharacterCreatorTextScaler.cs" Link="CharacterCreatorTextScaler.cs" />
    <Compile Include="../../Assets/StartupLife/Scripts/Presentation/CharacterCreatorKeyboardAvoidance.cs" Link="CharacterCreatorKeyboardAvoidance.cs" />
    <Compile Include="UnityStubs.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
