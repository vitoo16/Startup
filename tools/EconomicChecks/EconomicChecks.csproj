<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Link historical source fixtures; never fork or silently regenerate their bytes. -->
    <None Include="../SimulationChecks/Fixtures/synthetic-v0.json"
          Link="Fixtures/Legacy/synthetic-v0.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../SimulationChecks/Fixtures/current-v1.json"
          Link="Fixtures/Legacy/current-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Real Android-captured V1 release save; do not regenerate from a new simulator. -->
    <None Include="../../docs/evidence/M7-T02/RUNTIME-2026-10-04/android-final/B-before-work.save.json"
          Link="Fixtures/Legacy/real-v1-employment.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../SimulationChecks/StartupLife.Core.csproj" />
    <ProjectReference Include="../SimulationChecks/StartupLife.Simulation.csproj" />
    <ProjectReference Include="../SimulationChecks/StartupLife.Application.csproj" />
    <ProjectReference Include="../SimulationChecks/StartupLife.Integration.csproj" />
    <ProjectReference Include="../SimulationChecks/StartupLife.Infrastructure.csproj" />
    <Compile Include="../../Assets/StartupLife/Scripts/Content/M9T02FunctionalEconomy.cs" Link="M9T02FunctionalEconomy.cs" />
    <Compile Include="../../Assets/StartupLife/Scripts/Content/ContentCatalogSource.cs" Link="ContentCatalogSource.cs" />
    <Compile Include="../../Assets/StartupLife/Scripts/Content/FirstPlayableContentTemplate.cs" Link="FirstPlayableContentTemplate.cs" />
    <Compile Include="../../Assets/StartupLife/Scripts/Content/BundledHistoricalV2ContentResolver.cs" Link="BundledHistoricalV2ContentResolver.cs" />
  </ItemGroup>
</Project>
